# Copy to terraform.tfvars (which is git-ignored) and fill in real values.
# Never commit terraform.tfvars: it holds secrets.

aws_region         = "ap-southeast-2"
environment        = "dev"
project_name       = "saas-platform"
availability_zones = ["ap-southeast-2a", "ap-southeast-2b", "ap-southeast-2c"]

db_master_password = "change-me"
redis_auth_token   = "change-me-at-least-16-characters"
