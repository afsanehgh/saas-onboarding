APP_NAME="SaaS Onboarding API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
# SQLite (default) needs no database server: the file database/database.sqlite is
# created by `composer run setup`. To use PostgreSQL instead, set:
#   DB_CONNECTION=pgsql, DB_HOST=127.0.0.1, DB_PORT=5432,
#   DB_DATABASE=saas_platform, DB_USERNAME=..., DB_PASSWORD=...
# Docker Compose and CI set PostgreSQL automatically.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Use "redis" when Redis is available (Docker Compose sets this for you).
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend origin allowed to call the API from the browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Domain events: log | kafka | null
# "log" writes events to storage/logs/laravel.log and needs no broker.
# "kafka" targets Apache Kafka / Amazon MSK and requires the rdkafka PHP extension.
EVENT_DRIVER=log
EVENT_TOPIC_PREFIX=
KAFKA_BROKERS=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Onboarding and personalisation
ONBOARDING_SKIP_ALLOWED=true
RECOMMENDATION_CACHE_HOURS=6
